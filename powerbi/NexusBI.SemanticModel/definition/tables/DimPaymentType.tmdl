/// Payment method dimension.
table DimPaymentType
	lineageTag: 55cfa75d-ec16-5e71-9507-5acfb0291ddb

	column payment_type_key
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 6ffbce48-37b7-5dfb-b870-54e9354c8d1e
		summarizeBy: none
		sourceColumn: payment_type_key

		annotation SummarizationSetBy = Automatic

	column payment_type
		dataType: string
		lineageTag: e2af7125-0f2e-5503-a3de-352c8e037a08
		summarizeBy: none
