/// ML: weekly category demand backtest + 4-week forecast.
table DemandForecast
	lineageTag: 28dfba72-936c-50ea-8fba-c9da96390b1f

	column category
		dataType: string
		lineageTag: a7f3c006-2eb7-54e6-9909-4073e2581404
		summarizeBy: none
		sourceColumn: category

		annotation SummarizationSetBy = Automatic

	column week_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: d4467bae-5986-5ca2-9eb5-a4ef16ac59a3
		summarizeBy: none
		sourceColumn: week_start

		annotation SummarizationSetBy = Automatic

	column model_name
		dataType: string
		lineageTag: c6b367db-6c8b-5a95-8516-a9514139461a
		summarizeBy: none
		sourceColumn: model_name

		annotation SummarizationSetBy = Automatic

	column kind
		dataType: string
		lineageTag: c4466d07-e34b-59fb-8f86-d29ac5aa6021
		summarizeBy: none
		sourceColumn: kind

		annotation SummarizationSetBy = Automatic

	column actual
		dataType: decimal
		formatString: #,0.00
		lineageTag: a0691312-4160-52e4-a9ce-0e9085ff5c86
		summarizeBy: sum
		sourceColumn: actual

		annotation SummarizationSetBy = Automatic

	column predicted
		dataType: decimal
		formatString: #,0.00
		lineageTag: fb5af712-da9b-54b7-b540-ffcdb944e810
		summarizeBy: sum
		sourceColumn: predicted

		annotation SummarizationSetBy = Automatic

	column lower_95
		dataType: decimal
		formatString: #,0.00
		lineageTag: eba50028-4bcf-59c2-aefd-21a7202a2d0e
		summarizeBy: sum
		sourceColumn: lower_95

		annotation SummarizationSetBy = Automatic

	column upper_95
		dataType: decimal
		formatString: #,0.00
		lineageTag: d4f11541-7deb-5dfe-9763-5fb8cd6ef674
		summarizeBy: sum
		sourceColumn: upper_95

		annotation SummarizationSetBy = Automatic

	partition DemandForecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\demand_forecast.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"category", "week_start", "model_name", "kind", "actual", "predicted", "lower_95", "upper_95"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"category", type text}, {"week_start", type date}, {"model_name", type text}, {"kind", type text}, {"actual", Currency.Type}, {"predicted", Currency.Type}, {"lower_95", Currency.Type}, {"upper_95", Currency.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
