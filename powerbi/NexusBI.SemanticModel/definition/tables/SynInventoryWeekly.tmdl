/// SIMULATED weekly inventory – synthetic, not real data.
table SynInventoryWeekly
	lineageTag: b0ce16b7-e442-5d3a-9b11-8f26d746cef2

	column category
		dataType: string
		lineageTag: 9cb5c8e8-0b04-5daf-97fc-22f8a557c8af
		summarizeBy: none
		sourceColumn: category

		annotation SummarizationSetBy = Automatic

	column week_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 224802b9-7c62-5e96-9c8f-ff662b19ab2f
		summarizeBy: none
		sourceColumn: week_start

		annotation SummarizationSetBy = Automatic

	column opening_stock
		dataType: int64
		formatString: 0
		lineageTag: a899007a-88c3-5665-9821-51d90908b00f
		summarizeBy: sum
		sourceColumn: opening_stock

		annotation SummarizationSetBy = Automatic

	column received_units
		dataType: int64
		formatString: 0
		lineageTag: ca357c7e-5b27-52da-bc00-dff17ab93419
		summarizeBy: sum
		sourceColumn: received_units

		annotation SummarizationSetBy = Automatic

	column demand_units
		dataType: int64
		formatString: 0
		lineageTag: 13748bd6-69b9-5e06-85a3-100965f80cab
		summarizeBy: sum
		sourceColumn: demand_units

		annotation SummarizationSetBy = Automatic

	column fulfilled_units
		dataType: int64
		formatString: 0
		lineageTag: 93b9210a-9d31-57b8-88c0-451021e65c4e
		summarizeBy: sum
		sourceColumn: fulfilled_units

		annotation SummarizationSetBy = Automatic

	column lost_sales_units
		dataType: int64
		formatString: 0
		lineageTag: b738563a-c98f-586b-8838-03aa165b599d
		summarizeBy: sum
		sourceColumn: lost_sales_units

		annotation SummarizationSetBy = Automatic

	column closing_stock
		dataType: int64
		formatString: 0
		lineageTag: b485983c-6c72-5c00-a8ba-a6686bbac29a
		summarizeBy: sum
		sourceColumn: closing_stock

		annotation SummarizationSetBy = Automatic

	column reorder_point
		dataType: int64
		formatString: 0
		lineageTag: fe303a24-72d0-5852-9453-e34db82988d5
		summarizeBy: sum
		sourceColumn: reorder_point

		annotation SummarizationSetBy = Automatic

	column is_stockout
		dataType: boolean
		lineageTag: 2122986c-8262-5420-8d42-c4879dc5a4de
		summarizeBy: none
		sourceColumn: is_stockout

		annotation SummarizationSetBy = Automatic

	column is_synthetic
		dataType: boolean
		lineageTag: 0e3c70c9-f3b3-524f-a8e4-4177e1740288
		summarizeBy: none
		sourceColumn: is_synthetic

		annotation SummarizationSetBy = Automatic

	partition SynInventoryWeekly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\syn_inventory_weekly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"category", "week_start", "opening_stock", "received_units", "demand_units", "fulfilled_units", "lost_sales_units", "closing_stock", "reorder_point", "is_stockout", "is_synthetic"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"category", type text}, {"week_start", type date}, {"opening_stock", Int64.Type}, {"received_units", Int64.Type}, {"demand_units", Int64.Type}, {"fulfilled_units", Int64.Type}, {"lost_sales_units", Int64.Type}, {"closing_stock", Int64.Type}, {"reorder_point", Int64.Type}, {"is_stockout", type logical}, {"is_synthetic", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
