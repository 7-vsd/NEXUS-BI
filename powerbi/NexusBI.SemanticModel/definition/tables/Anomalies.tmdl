		formatString: 0.00
		lineageTag: c3492b99-114d-549e-b73f-08040612a654
		summarizeBy: sum
		sourceColumn: late_rate

		annotation SummarizationSetBy = Automatic

	column avg_review
		dataType: double
		formatString: 0.00
		lineageTag: e641d3b7-5467-5574-a730-a06889c06d95
		summarizeBy: sum
		sourceColumn: avg_review

		annotation SummarizationSetBy = Automatic

	column iforest_score
		dataType: double
		formatString: 0.00
		lineageTag: 83bb0c05-b62a-5b48-93a8-ef9c24612d63
		summarizeBy: none
		sourceColumn: iforest_score

		annotation SummarizationSetBy = Automatic

	column iforest_flag
		dataType: boolean
		lineageTag: 3998cf24-22e3-5e4c-b23b-f6fd76d0ff6a
		summarizeBy: none
		sourceColumn: iforest_flag

		annotation SummarizationSetBy = Automatic

	column rolling_z
		dataType: double
		formatString: 0.00
		lineageTag: ea976c6d-8e13-5ea3-90df-93f16fc659e8
		summarizeBy: sum
		sourceColumn: rolling_z

		annotation SummarizationSetBy = Automatic

	column rolling_flag
		dataType: boolean
		lineageTag: 52e6dc09-febb-5f32-9d98-cafd181096a7
		summarizeBy: none
		sourceColumn: rolling_flag

		annotation SummarizationSetBy = Automatic

	column global_z
		dataType: double
		formatString: 0.00
		lineageTag: c7a47387-6530-5de8-9e3c-c34751e6e19c
		summarizeBy: sum
		sourceColumn: global_z

		annotation SummarizationSetBy = Automatic

	column zscore_flag
		dataType: boolean
		lineageTag: 41ce1294-b242-57e6-8b3b-59e0564800e6
		summarizeBy: none
		sourceColumn: zscore_flag

		annotation SummarizationSetBy = Automatic

	column votes
		dataType: int64
		formatString: 0
		lineageTag: a7c3088e-5b3f-5daa-a702-a1e64b829756
		summarizeBy: sum
		sourceColumn: votes

