/// ML: daily KPI anomaly scores and flags.
table Anomalies
	lineageTag: a830703a-058d-574a-b35a-b70ed8723784

	column metric_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 3ce6682b-2ed4-5be2-a2ec-d0929c22607f
		summarizeBy: none
		sourceColumn: metric_date

		annotation SummarizationSetBy = Automatic

	column revenue
		dataType: decimal
		formatString: #,0.00
		lineageTag: 6e09e770-0848-5c84-b784-51e13cec6746
		summarizeBy: sum
		sourceColumn: revenue

		annotation SummarizationSetBy = Automatic

	column orders
		dataType: int64
		formatString: 0
		lineageTag: 9c6d2e1b-ebe4-5d7f-b145-d5caf8ff8e53
		summarizeBy: sum
		sourceColumn: orders

		annotation SummarizationSetBy = Automatic

	column aov
		dataType: decimal
		formatString: #,0.00
		lineageTag: 0e8d9911-560a-5c11-8e6a-1ca3b78c828f
		summarizeBy: sum
		sourceColumn: aov

		annotation SummarizationSetBy = Automatic

	column late_rate
