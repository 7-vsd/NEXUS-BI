  "components": {
    "schemas": {
      "AnomalyRequest": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "revenue": {
            "type": "number",
            "minimum": 0.0,
            "title": "Revenue"
          },
          "orders": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Orders"
          },
          "late_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Late Rate",
            "default": 0.0
          },
          "avg_review": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Avg Review",
            "default": 4.1
          },
          "cancel_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Cancel Rate",
            "default": 0.0
          },
          "recent_revenue": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array",
                "maxItems": 90,
                "minItems": 14
              },
              {
                "type": "null"
              }
            ],
            "title": "Recent Revenue",
            "description": "Optional trailing daily revenue (oldest->newest). Defaults to the last 28 training days."
          },
          "recent_orders": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array",
                "maxItems": 90,
                "minItems": 14
              },
              {
                "type": "null"
              }
            ],
            "title": "Recent Orders"
          }
        },
        "type": "object",
        "required": [
          "date",
          "revenue",
          "orders"
        ],
        "title": "AnomalyRequest",
        "example": {
          "avg_review": 4.1,
          "cancel_rate": 0.004,
          "date": "2018-08-20",
          "late_rate": 0.05,
          "orders": 600,
          "revenue": 95000
        }
      },
      "AnomalyResponse": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "is_anomaly": {
            "type": "boolean",
            "title": "Is Anomaly"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "direction": {
            "type": "string",
            "title": "Direction"
          },
          "votes": {
            "type": "integer",
            "title": "Votes"
          },
          "flags": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Flags"
          },
          "iforest_score": {
            "type": "number",
            "title": "Iforest Score"
          },
          "rolling_z": {
            "type": "number",
            "title": "Rolling Z"
          },
          "global_z": {
            "type": "number",
            "title": "Global Z"
          }
        },
        "type": "object",
        "required": [
          "date",
          "is_anomaly",
          "severity",
          "direction",
          "votes",
          "flags",
          "iforest_score",
          "rolling_z",
          "global_z"
        ],
        "title": "AnomalyResponse"
      },
      "ChurnFeatures": {
        "properties": {
          "customer_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id"
          },
          "recency_days": {
            "type": "number",
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Recency Days"
          },
          "frequency": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Frequency"
          },
          "monetary": {
            "type": "number",
            "minimum": 0.0,
            "title": "Monetary"
          },
          "avg_order_value": {
            "type": "number",
            "minimum": 0.0,
            "title": "Avg Order Value"
          },
          "tenure_days": {
            "type": "number",
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Tenure Days",
            "default": 0
          },
          "avg_items": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Avg Items",
            "default": 1
          },
          "avg_review": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Review"
          },
          "last_review": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Review"
          },
          "pct_late": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Pct Late"
          },
          "avg_delivery_days": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 365.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Delivery Days"
          },
          "avg_freight_ratio": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 50.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Freight Ratio"
          },
          "max_installments": {
            "type": "number",
            "maximum": 36.0,
            "minimum": 1.0,
            "title": "Max Installments",
            "default": 1
          },
          "n_categories": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "N Categories",
            "default": 1
          },
          "days_since_first": {
            "type": "number",
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Days Since First"
          },
          "customer_region": {
            "type": "string",
            "enum": [
              "Norte",
              "Nordeste",
              "Centro-Oeste",
              "Sudeste",
              "Sul",
              "Unknown"
            ],
            "title": "Customer Region",
            "default": "Sudeste"
          },
          "last_payment_type": {
            "type": "string",
            "enum": [
              "credit_card",
              "boleto",
              "voucher",
              "debit_card",
              "not_defined",
              "unknown"
            ],
            "title": "Last Payment Type",
            "default": "credit_card"
          }
        },
        "type": "object",
        "required": [
          "recency_days",
          "frequency",
          "monetary",
          "avg_order_value",
          "days_since_first"
        ],
        "title": "ChurnFeatures",
        "description": "Behavioural features of ONE customer as of the scoring date (history only).",
        "example": {
          "avg_delivery_days": 9.5,
          "avg_freight_ratio": 0.18,
          "avg_items": 1,
          "avg_order_value": 189.9,
          "avg_review": 5,
          "customer_region": "Sudeste",
          "days_since_first": 45,
          "frequency": 1,
          "last_payment_type": "credit_card",
          "last_review": 5,
          "max_installments": 3,
          "monetary": 189.9,
          "n_categories": 1,
          "pct_late": 0,
          "recency_days": 45,
          "tenure_days": 0
        }
      },
      "ChurnPrediction": {
        "properties": {
          "customer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id"
          },
          "churn_probability": {
            "type": "number",
            "title": "Churn Probability"
          },
          "return_probability": {
            "type": "number",
            "title": "Return Probability"
          },
          "predicted_churn": {
            "type": "boolean",
            "title": "Predicted Churn"
          },
          "risk_band": {
            "type": "string",
            "title": "Risk Band"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "churn_probability",
          "return_probability",
          "predicted_churn",
          "risk_band"
        ],
        "title": "ChurnPrediction"
      },
      "ChurnRequest": {
        "properties": {
          "customers": {
            "items": {
              "$ref": "#/components/schemas/ChurnFeatures"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Customers"
          }
        },
        "type": "object",
        "required": [
          "customers"
        ],
        "title": "ChurnRequest"
      },
      "ChurnResponse": {
        "properties": {
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "horizon_days": {
            "type": "integer",
            "title": "Horizon Days"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/ChurnPrediction"
            },
            "type": "array",
            "title": "Predictions"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          }
        },
        "type": "object",
        "required": [
          "model_name",
          "threshold",
          "horizon_days",
          "predictions",
          "disclaimer"
        ],
        "title": "ChurnResponse"
      },
      "CustomerSegmentResponse": {
        "properties": {
          "selected_k": {
            "type": "integer",
            "title": "Selected K"
          },
          "silhouette": {
            "type": "number",
            "title": "Silhouette"
          },
          "clusters": {
            "items": {
              "$ref": "#/components/schemas/SegmentSummary"
            },
            "type": "array",
            "title": "Clusters"
          },
          "rfm_segments": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rfm Segments"
          },
          "customer": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer"
          }
        },
        "type": "object",
        "required": [
          "selected_k",
          "silhouette",
          "clusters",
          "rfm_segments"
        ],
        "title": "CustomerSegmentResponse"
      },
      "DemandForecastRequest": {
        "properties": {
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Category"
          },
          "horizon_weeks": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Horizon Weeks",
            "default": 4
          },
          "model": {
            "type": "string",
            "enum": [
              "best",
              "naive",
              "moving_avg_4w",
              "seasonal_naive_52w",
              "xgboost"
            ],
            "title": "Model",
            "default": "best"
          }
        },
        "type": "object",
        "required": [
          "category"
        ],
        "title": "DemandForecastRequest"
      },
