{
  "openapi": "3.1.0",
  "info": {
    "title": "NEXUS BI API",
    "description": "Enterprise KPIs and predictive analytics for the Olist e-commerce dataset. All monetary values are in BRL. Forecasts come from models trained by `ml.train_all`.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "parameters": [
          {
            "name": "check_db",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "also probe PostgreSQL",
              "default": false,
              "title": "Check Db"
            },
            "description": "also probe PostgreSQL"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Model or data not available yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/business-kpis": {
      "get": {
        "tags": [
          "Business KPIs"
        ],
        "summary": "Business Kpis",
        "operationId": "business_kpis_api_business_kpis_get",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "inclusive, purchase date",
              "title": "Start Date"
            },
            "description": "inclusive, purchase date"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "inclusive, purchase date",
              "title": "End Date"
            },
            "description": "inclusive, purchase date"
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 2
                },
                {
                  "type": "null"
                }
              ],
              "description": "customer state (UF), e.g. SP",
              "title": "State"
            },
            "description": "customer state (UF), e.g. SP"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "main order category (English)",
              "title": "Category"
            },
            "description": "main order category (English)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KPIResponse"
                }
              }
            }
          },
          "503": {
            "description": "Model or data not available yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
