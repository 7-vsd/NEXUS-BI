# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------- PostgreSQL
NEXUS_DB_HOST=localhost
NEXUS_DB_PORT=5432
NEXUS_DB_NAME=nexus_bi
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=change-me

# ---------------------------------------------------------------- Services
NEXUS_API_URL=http://localhost:8000
NEXUS_API_TIMEOUT=15
NEXUS_LOG_LEVEL=INFO

# ---------------------------------------------------------------- Pipeline
# Optional: read the raw CSVs from another folder (default: ./data/raw)
# NEXUS_RAW_DIR=C:\path\to\olist\csvs
NEXUS_LOAD_BATCH_SIZE=50000
NEXUS_RANDOM_SEED=42

# ---------------------------------------------------------------- Docker compose (PostgreSQL container)
POSTGRES_PASSWORD=change-me
